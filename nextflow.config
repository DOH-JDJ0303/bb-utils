/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    bb-utils configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // Required
    db                = null                    // BigBacter database (local, s3://, gs://, az://)
    mode              = null                    // summary | remove | push

    // General
    outdir            = 'bb_utils_results'  // Reports and manifests
    dry_run           = false                   // remove/push: report only, change nothing
    threads           = 16                      // Parallel list/copy/delete operations
    help              = false

    // Selection
    taxa              = null                    // Taxon (remove: exactly one; summary/push: optional, comma-separated)
    cluster           = null                    // Cluster (remove: one; summary: optional, comma-separated)

    // remove
    samples           = null                    // Comma-separated sample names, or a file with one per line
    added_after       = null                    // Remove samples added at or after this time
    added_before      = null                    // Remove samples added before this time
    all               = false                   // Remove the whole taxon
    prune_empty       = true                    // Delete clusters left with no samples

    // push
    run               = null                    // BigBacter run directory: <outdir>/<timestamp>
    overwrite         = false                   // Replace sample files already in the database
    allow_missing_sig = false                   // Push samples that have no signature in the run
}

manifest {
    name            = 'bb-utils'
    description     = 'Summarise, prune and update a BigBacter database'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.04.0'
    version         = '0.1.0'
}

// No processes are run, so no container engine, executor or work directory settings are needed.
// Cloud credentials are picked up the same way as for BigBacter (aws, google and azure scopes).
